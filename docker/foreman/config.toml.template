# Foreman v4 container config — envsubst template.
#
# All paths are container-internal. The image bakes this file at
# /etc/foreman/config.toml.template; the entrypoint runs ``envsubst`` on
# it at container start to expand ${FOREMAN_*} placeholders into a real
# config at $FOREMAN_V4_CONFIG (default /foreman/state/config.toml).
#
# Schema: foreman.v4.config.V4Config. Per-project [[projects]] is an
# array of tables (TOML double-bracket); apps + orchestrator live at
# the top level because v4 uses one App installation per role across
# all v4-managed repos (see foreman.v4.identity.V4IdentityRegistry).
#
# NOTE: no [admin] section here. FOREMAN_ADMIN_TOKEN is only consumed
# by ``foreman init`` (host-side bootstrap to create labels in a target
# repo); the daemon at runtime authenticates as the role Apps directly.

[daemon]
log_dir = "/foreman/logs"
log_level = "INFO"
tick_seconds = 30.0
max_in_flight = 1
role_timeout_seconds = 1800
# foreman#483 no-output inactivity watchdog: DISABLED (0) 2026-07-13.
# It false-killed legitimate long *silent* role phases — cold uv syncs and,
# decisively, the Worker's pre-model ``just check`` baseline test run, which on
# a heavy repo (agent_core's pytest suite) runs well past the old 300s window
# with zero stdout. The wall-clock ``role_timeout_seconds`` above (30 min) is
# the real hang backstop; a second output-based timer only produced false
# positives. 0 disables the watchdog (``if self._inactivity_timeout > 0`` guard
# in subprocess_dispatcher). Re-enable with a value in seconds if a genuine
# silent-hang class ever needs a tighter-than-wall-clock trip.
role_inactivity_timeout_seconds = 0
max_state_attempts = 3

# Persistence is Postgres-only (kill-sqlite). ``engine`` is fixed to
# "postgres"; StorageConfig refuses to load (loud fail) if ``dsn`` is
# empty, so ${FOREMAN_PG_DSN} MUST be set in .env (docker-compose already
# passes it to the daemon). There is no SQLite fallback, and no SQLite
# snapshot scheduler — Postgres DR is tracked in jeffrichley/foreman#434.
[storage]
engine = "postgres"
dsn = "${FOREMAN_PG_DSN}"
pool_min = 2
pool_max = 10

# foreman#434: pg_dump snapshot scheduler. Backups write to /foreman/backups
# (bind-mounted to ${HOME}/.foreman/backups on the host — survives down -v).
# Set enabled = false to disable; tune interval_seconds and retention_* to taste.
[backup]
enabled = true
dir = "/foreman/backups"
interval_seconds = 3600
retention_hourly = 24
retention_daily = 7
retention_weekly = 4

[apps]
planner = { app_id = ${FOREMAN_PLANNER_APP_ID}, private_key_path = "/run/secrets/planner_pem" }
reviewer = { app_id = ${FOREMAN_REVIEWER_APP_ID}, private_key_path = "/run/secrets/reviewer_pem" }
fixer = { app_id = ${FOREMAN_FIXER_APP_ID}, private_key_path = "/run/secrets/fixer_pem" }
worker = { app_id = ${FOREMAN_WORKER_APP_ID}, private_key_path = "/run/secrets/worker_pem" }

[orchestrator]
app_id = ${FOREMAN_ORCHESTRATOR_APP_ID}
private_key_path = "/run/secrets/orchestrator_pem"

# Issue #347: operator identities used for the per-commit
# ``Supervised-by:`` (orchestration attribution) and ``Signed-off-by:``
# (DCO legal attestation) trailers on every bot commit. Both
# sub-tables are REQUIRED; the four ${FOREMAN_OPERATOR_*} placeholders
# are expanded by ``envsubst`` at container start (set them in your
# ``.env`` alongside ``FOREMAN_PLANNER_APP_ID`` etc.).
[operator.supervisor]
name = "${FOREMAN_OPERATOR_SUPERVISOR_NAME}"
email = "${FOREMAN_OPERATOR_SUPERVISOR_EMAIL}"

[operator.signer]
name = "${FOREMAN_OPERATOR_SIGNER_NAME}"
email = "${FOREMAN_OPERATOR_SIGNER_EMAIL}"

# [[projects]] tables are no longer baked into this template.
# The project list is the sole responsibility of the host-mounted
# $FOREMAN_PROJECTS_PATH file (default /root/.foreman/projects.toml).
# Edit that file and run `foreman daemon reload` to add, remove, or
# rename a tracked repo — no image rebuild or container restart needed.
# See docker/foreman/projects.toml.example for the file format.
