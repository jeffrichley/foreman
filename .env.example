# Foreman daemon container — runtime env vars.
# Copy to .env (gitignored) and fill in real values before
# `docker compose up -d daemon`.

# Note: FOREMAN_ADMIN_TOKEN is intentionally NOT here. It is only used
# by `foreman init` (one-shot host-side bootstrap to create labels in a
# target repo). The containerized daemon authenticates via GitHub Apps
# (the 4 PEMs mounted as Compose secrets), not via a PAT.

# Anthropic Max — long-lived OAuth token. Generate via the container so
# the token never enters the host's claude environment:
#     docker run --rm -it foreman:dev claude setup-token
# (Opens device-code OAuth flow, prints a 1-year token to stdout — paste
# below.) The container's CLAUDE_CONFIG_DIR is isolated to
# /root/.claude-container so any refresh writes stay inside the
# container and never touch the host's ~/.claude/. Replaces the prior
# shared-credentials.json mount that created a host-container race (see
# foreman#392). Rotate annually; `foreman creds status` warns at < 30 days.
FOREMAN_CLAUDE_OAUTH_TOKEN=<paste-token-from-claude-setup-token>

# GitHub Apps — numeric IDs of the role bots. Find each ID at
# https://github.com/settings/apps/<app-name> ("App ID:" field).
# Operator-specific; not committed.
FOREMAN_ORCHESTRATOR_APP_ID=<your-orchestrator-app-id>
FOREMAN_PLANNER_APP_ID=<your-planner-app-id>
FOREMAN_REVIEWER_APP_ID=<your-reviewer-app-id>
FOREMAN_FIXER_APP_ID=<your-fixer-app-id>
FOREMAN_WORKER_APP_ID=<your-worker-app-id>

# Operator identities for the Supervised-by / Signed-off-by commit
# trailers every bot commit carries (#347 / PR #354).
# Supervisor = the human (or being) who dispatched the autonomous run.
# Signer = the human accepting DCO responsibility for the change.
# All four are REQUIRED — V4Config raises ValidationError on missing or
# empty values and the daemon will not start. They can be the same
# person, in which case both name/email pairs match.
FOREMAN_OPERATOR_SUPERVISOR_NAME=<your-supervisor-name>
FOREMAN_OPERATOR_SUPERVISOR_EMAIL=<your-supervisor-email>
FOREMAN_OPERATOR_SIGNER_NAME=<your-signer-name>
FOREMAN_OPERATOR_SIGNER_EMAIL=<your-signer-email>

# Container-internal paths (compose sets these; rarely need to change).
# FOREMAN_V4_CONFIG is the rendered config file location. The entrypoint
# runs envsubst on /etc/foreman/config.toml.template (image-baked) and
# writes the result to this path; the daemon reads $FOREMAN_V4_CONFIG.
FOREMAN_V4_CONFIG=/foreman/state/config.toml
FOREMAN_LOG_DIR=/foreman/logs
FOREMAN_STATE_DIR=/foreman/state
